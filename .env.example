# Barter (OpenAI-compatible Codex proxy) configuration

# Admin key used to bootstrap and manage service keys via /v1/keys.
# Must start with "brtr-".
# Generate one with: ./barter gen-admin-key
BARTER_ADMIN_KEY=brtr-change-me

# SQLite DB path for issued keys (defaults to ./barter.db if unset).
# BARTER_DB=/absolute/path/to/barter.db

# Default reasoning effort when the client does not specify one.
# Allowed: none, minimal, low, medium, high, xhigh
BARTER_DEFAULT_EFFORT=medium

# Tool-call limits for /v1/responses when tools are enabled (web_search, code_interpreter, mcp).
# For efforts > BARTER_TOOL_CALL_CUTOFF_EFFORT (default: medium), tool calls are unlimited by default.
BARTER_TOOL_CALL_CUTOFF_EFFORT=medium
BARTER_TOOL_CALL_LIMIT=5
# Optional: set to a number to cap tool calls even above the cutoff, or "unlimited" to leave unbounded.
# BARTER_TOOL_CALL_LIMIT_ABOVE_CUTOFF=unlimited

# Safety valve: stop tool-calling after this many consecutive invalid tool decisions.
BARTER_TOOL_CALL_MAX_BAD_TURNS=8

# Codex CLI backend
CODEX_BINARY=codex
CODEX_WORKDIR=.
CODEX_TIMEOUT_SECONDS=900

# Optional: prevent Codex CLI from running local shell commands (recommended for API deployments).
# BARTER_CODEX_DISABLE_SHELL_TOOL=1

# Server (CLI only; uvicorn also supports env via many process managers)
# BARTER_HOST=127.0.0.1
# BARTER_PORT=8000
# BARTER_LOG_LEVEL=info

