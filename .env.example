# Admin key used to bootstrap and manage service keys via /v1/keys.
# Generate one with: ./barter gen-admin-key
BARTER_ADMIN_KEY=brtr-

# SQLite DB path for issued keys (defaults to barter.db if unset).
# BARTER_DB=barter.db

# Default reasoning effort when the client does not specify one.
# Allowed: none, minimal, low, medium, high, xhigh
BARTER_DEFAULT_EFFORT=low

# Stop tool-calling after this many consecutive invalid tool decisions.
BARTER_TOOL_CALL_MAX_BAD_TURNS=8

# Local Python code-interpreter sandbox limits.
# BARTER_CODE_SANDBOX_MAX_MEMORY_MB=256
# BARTER_CODE_SANDBOX_MAX_CPU_SECONDS=10
# BARTER_CODE_SANDBOX_MAX_FILE_BYTES=10485760
# BARTER_CODE_SANDBOX_MAX_OPEN_FILES=64
# BARTER_CODE_SANDBOX_MAX_PROCESSES=32
# BARTER_CODE_SANDBOX_MAX_OUTPUT_BYTES=100000

# Codex CLI backend
CODEX_BINARY=codex
CODEX_WORKDIR=.
CODEX_TIMEOUT_SECONDS=900

# Prevent Codex CLI from running local shell commands (recommended for API deployments).
BARTER_CODEX_DISABLE_SHELL_TOOL=1

# Server (CLI only; uvicorn also supports env via many process managers)
# BARTER_HOST=127.0.0.1
# BARTER_PORT=8000
# BARTER_LOG_LEVEL=info
